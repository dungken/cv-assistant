\section{Experience \& Projects}

% --- SST ---
\noindent
\textbf{\color{primary}Backend .NET Developer} \hfill \textcolor{darkgray}{\small Jan 2026 -- Jun 2026}\\[1pt]
\textbf{Smart Sports Tablet (SST)} \textcolor{darkgray}{\small · Full-time · Remote · Team size: 5 developers} \hfill \href{https://smartsports.vn/}{\textcolor{secondary}{\small \faGlobe\ smartsports.vn}} | \textcolor{darkgray}{\small \faLock\ \textit{NDA}}\\[2pt]
{\small\textbf{Stack:} \textbf{C\# / .NET 9} (Clean Architecture, CQRS / MediatR, EF Core), \textbf{SQL Server}, Vue 3 + TypeScript, Ant Design Vue, Flutter, SignalR}\\[2pt]
{\small\textit{SST provides an integrated sports management solution (tablet + web + mobile app) for venues running billiards, pickleball, and badminton. The platform connects physical tablet devices at each table/court with a central web dashboard and Flutter app for real-time operations.}}
\begin{itemize}[leftmargin=14pt,itemsep=2pt,topsep=3pt,label={•}]
    \item \textbf{Backend Architecture (.NET 9):} Designed and developed the core backend applying \textbf{Clean Architecture} and \textbf{CQRS with MediatR}. Defined domain models, application services, and repository layers following \textbf{SOLID} principles. Managed all data access via \textbf{Entity Framework Core} on \textbf{SQL Server}.
    \item \textbf{Tournament Module:} Built a complete tournament management flow — creating tournaments, generating \textbf{bracket/draw diagrams} (round-robin, elimination), scheduling match timetables, and broadcasting \textbf{real-time scores} from tablets and web to all connected clients via \textbf{SignalR}.
    \item \textbf{Multi-level RBAC:} Designed and implemented a \textbf{role-based access control} system with 5 levels: \textit{Admin, Club, Agency, Staff, Member}. Each role has distinct permissions over data and operations, enforced at both API and business logic layers.
    \item \textbf{Web \& App Contribution:} Primary responsibility on the \textbf{Vue 3 + TypeScript} web management dashboard (Ant Design Vue, Pinia). Also contributed to the \textbf{Flutter} tablet/mobile app for the tournament module when needed.
\end{itemize}
